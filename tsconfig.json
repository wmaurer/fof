{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "types": ["node"]
    },
    "include": [
        "apps/*/src/**/*.ts",
        "apps/*/src/**/*.tsx",
        "apps/*/test/**/*.ts",
        "apps/*/test/**/*.tsx",
        "apps/*/vitest.config.ts",
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.tsx",
        "packages/*/test/**/*.ts",
        "packages/*/test/**/*.tsx",
        "packages/*/vitest.config.ts",
        "vitest.config.ts"
    ]
}
